# hypothesis property-test database/cache
.hypothesis/

# Sphinx build output
docs/_build/

# Literature (reference/literature): the SOURCES are local copies only -- fetch
# them from the URLs in reference/literature/README.md rather than committing
# PDFs. The extracted reference notes (*.md) ARE tracked: they are what the
# repository cites, and they must travel with a clone.
reference/literature/*.pdf
reference/literature/*.txt
reference/literature/*.djvu
reference/literature/*.ps

# Claude Code worktrees (embedded checkouts, never part of this repo)
.claude/worktrees/
.worktrees/
.superpowers/

# Published run artifacts (see docs/adr/0008). Only the two KB-sized records
# are tracked -- `manifest.json` (what the run was) and `artifacts.json` (where
# its bytes live and what they hash to). Everything else in these directories
# arrives via `qscat-run fetch` and must NOT come back: listing what to ignore
# would miss whatever a future artifact kind adds, and one `git add -A` after a
# fetch puts the whole sweep back in git. Allow-list instead.
validation/factory/results/o2-ve/*
!validation/factory/results/o2-ve/manifest.json
!validation/factory/results/o2-ve/artifacts.json
validation/factory/results/o2-so12-ve/*
!validation/factory/results/o2-so12-ve/manifest.json
!validation/factory/results/o2-so12-ve/artifacts.json
validation/factory/results/o2-so32-ve/*
!validation/factory/results/o2-so32-ve/manifest.json
!validation/factory/results/o2-so32-ve/artifacts.json
